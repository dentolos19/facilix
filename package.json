{
  "name": "facilix",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "postinstall": "bun run types",
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "types": "wrangler types && tsr generate",
    "check": "biome check --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DATABASE",
    "services": "docker compose up --build",
    "services:start": "docker compose up -d",
    "services:stop": "docker compose stop",
    "services:logs": "docker compose logs -f",
    "services:cctv": "docker compose up --build mediamtx cctv",
    "services:cctv:logs": "docker compose logs -f mediamtx cctv",
    "services:sensors": "docker compose up sensors",
    "services:sensors:logs": "docker compose logs -f sensors"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.5",
    "@cloudflare/vite-plugin": "^1.38.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.11",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.6.16",
    "konva": "^10.3.0",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.4",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.10",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.8.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.94.0"
  }
