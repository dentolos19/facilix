{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facilix",
  "account_id": "d910f54eba4cf3d1634aa41c3d9a93bc",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "logpush": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "route": {
    "pattern": "facilix.dennise.me",
    "custom_domain": true
  },
  "vars": {
    "CCTV_SIMULATION_RTSP_BASE": "rtsp://localhost:3003",
    "ROBOFLOW_API_BASE": "https://serverless.roboflow.com",
    "ROBOFLOW_PEOPLE_MODEL_ID": "cctv-naxyo/1",
    "ROBOFLOW_VEHICLE_MODEL_ID": "vehicles-q0x2v/1",
    "ROBOFLOW_PPE_MODEL_ID": "ppes-kaxsi/8",
    "ROBOFLOW_CONFIDENCE": "0.4"
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_id": "8d175dfa-86d8-46a5-8ab9-405e959dc896"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "facilix"
    }
  ],
  "workflows": [
    {
      "name": "facilix-processor",
      "binding": "PROCESSOR",
      "class_name": "Processor"
    }
  ],
  "containers": [
    {
      "name": "facilix-server",
      "class_name": "Server",
      "image": "../server/Dockerfile",
      "max_instances": 10,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVER",
        "class_name": "Server"
      },
      {
        "name": "OBSERVER",
        "class_name": "Observer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Server", "Observer"]
    }
  ]
}
