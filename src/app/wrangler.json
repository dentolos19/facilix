{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facilix",
  "main": "src/server.ts",
  "account_id": "d910f54eba4cf3d1634aa41c3d9a93bc",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "logpush": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "route": {
    "pattern": "facilix.dennise.me",
    "custom_domain": true
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "facilix"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "facilix"
    }
  ],
  "workflows": [
    {
      "binding": "PROCESSOR",
      "name": "facilix-processor",
      "class_name": "Processor"
    }
  ],
  "containers": [
    {
      "name": "facilix-server",
      "class_name": "Server",
      "image": "../server/Dockerfile",
      "max_instances": 5,
      "instance_type": "basic"
    },
    {
      "name": "facilix-simulator",
      "class_name": "Simulator",
      "image": "../simulator/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVER",
        "class_name": "Server"
      },
      {
        "name": "OBSERVER",
        "class_name": "Observer"
      },
      {
        "name": "SIMULATOR",
        "class_name": "Simulator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Server", "Observer", "Simulator"]
    }
  ]
}
