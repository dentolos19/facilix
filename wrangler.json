{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facilix-development",
  "main": "@tanstack/react-start/server-entry",
  "account_id": "d910f54eba4cf3d1634aa41c3d9a93bc",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "facilix"
    }
  ],
  "env": {
    "production": {
      "name": "denizen",
      "workers_dev": false,
      "logpush": true,
      "observability": {
        "logs": {
          "enabled": true
        },
        "traces": {
          "enabled": true
        }
      },
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "facilix",
          "remote": true
        }
      ]
    }
  }
}
