{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facilix",
  "main": "@tanstack/react-start/server-entry",
  "account_id": "d910f54eba4cf3d1634aa41c3d9a93bc",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "logpush": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "route": {
    "pattern": "facilix.dennise.me",
    "custom_domain": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "10d86a6d-56da-4b68-9002-35ca3aa4776d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "facilix"
    }
  ]
}
